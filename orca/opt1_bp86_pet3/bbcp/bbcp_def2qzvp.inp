#
# Calculations for Boys-Bernardi CP correction
#

%Compound

# --------------------------------------------
# Monomers
# --------------------------------------------
New_Step
! BP86 def2-QZVP VeryTightSCF defgrid3 NOAUTOSTART
%id "15h"
* xyzfile 0 1 opt1_pet3/15h_pet3_opt.xyz
Step_End

New_Step
! BP86 def2-QZVP VeryTightSCF defgrid3 NOAUTOSTART
%id "TPhP"
* xyzfile 0 1 opt1_pet3/TPhP_pet3_opt.xyz
Step_End

# --------------------------------------------
# Dimer
# --------------------------------------------
New_Step
! BP86 def2-QZVP VeryTightSCF defgrid3 NOAUTOSTART
%id "1b"
* xyzfile 0 1 opt1_pet3/1b_pet3_opt.xyz
Step_End

# --------------------------------------------
# Monomer at dimer geometry
# --------------------------------------------
New_Step
! BP86 def2-QZVP VeryTightSCF defgrid3 NOAUTOSTART
%id "15h_1b_geo"
* xyzfile 0 1 opt1_pet3/15h_1b_pet3_geo.xyz
Step_End

New_Step
! BP86 def2-QZVP VeryTightSCF defgrid3 NOAUTOSTART
%id "TPhP_1b_geo"
* xyzfile 0 1 opt1_pet3/TPhP_1b_pet3_geo.xyz
Step_End

# --------------------------------------------
# Monomer at dimer geometry with dimer basis
# --------------------------------------------
New_Step
! BP86 def2-QZVP VeryTightSCF defgrid3 NOAUTOSTART
%id "15h_1b_geo_basis"
* xyzfile 0 1 opt1_pet3/15h_1b_pet3_geo_basis.xyz
Step_End

New_Step
! BP86 def2-QZVP VeryTightSCF defgrid3 NOAUTOSTART
%id "TPhP_1b_geo_basis"
* xyzfile 0 1 opt1_pet3/TPhP_1b_pet3_geo_basis.xyz
Step_End

EndRun