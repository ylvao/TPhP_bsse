#
# Calculations for Boys-Bernardi CP correction
#

%Compound

# --------------------------------------------
# Monomers
# --------------------------------------------
New_Step
! BP86 X2C x2c-tzvpall X2C/J FiniteNuc VeryTightSCF defgrid3 NOAUTOSTART
%id "15h"
%rel
  FiniteNuc true
end
* xyzfile 0 1 xyz/15h_opt1.xyz
Step_End

New_Step
! BP86 X2C x2c-tzvpall X2C/J FiniteNuc VeryTightSCF defgrid3 NOAUTOSTART
%id "TPhP"
%rel
  FiniteNuc true
end
* xyzfile 0 1 xyz/TPhP_opt1.xyz
Step_End

# --------------------------------------------
# Dimer
# --------------------------------------------
New_Step
! BP86 X2C x2c-tzvpall X2C/J FiniteNuc VeryTightSCF defgrid3 NOAUTOSTART
%id "1b"
%rel
  FiniteNuc true
end
* xyzfile 0 1 xyz/1b_opt1.xyz
Step_End

# --------------------------------------------
# Monomer at dimer geometry
# --------------------------------------------
New_Step
! BP86 X2C x2c-tzvpall X2C/J FiniteNuc VeryTightSCF defgrid3 NOAUTOSTART
%id "15h_1b_geo"
%rel
  FiniteNuc true
end
* xyzfile 0 1 xyz/15h_1b_geo.xyz
Step_End

New_Step
! BP86 X2C x2c-tzvpall X2C/J FiniteNuc VeryTightSCF defgrid3 NOAUTOSTART
%id "TPhP_1b_geo"
%rel
  FiniteNuc true
end
* xyzfile 0 1 xyz/TPhP_1b_geo.xyz
Step_End

# --------------------------------------------
# Monomer at dimer geometry with dimer basis
# --------------------------------------------
New_Step
! BP86 X2C x2c-tzvpall X2C/J FiniteNuc VeryTightSCF defgrid3 NOAUTOSTART
%id "15h_1b_geo_basis"
%rel
  FiniteNuc true
end
* xyzfile 0 1 xyz/15h_1b_geo_basis.xyz
Step_End

New_Step
! BP86 X2C x2c-tzvpall X2C/J FiniteNuc VeryTightSCF defgrid3 NOAUTOSTART
%id "TPhP_1b_geo_basis"
%rel
  FiniteNuc true
end
* xyzfile 0 1 xyz/TPhP_1b_geo_basis.xyz
Step_End

EndRun